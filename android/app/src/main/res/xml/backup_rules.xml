<?xml version="1.0" encoding="utf-8"?>
<!-- No backup on Android 11 and lower (see data_extraction_rules.xml for 12+). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
