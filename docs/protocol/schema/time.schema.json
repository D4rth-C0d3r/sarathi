{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D4rth-C0d3r/sarathi/docs/protocol/schema/time.schema.json",
  "title": "time",
  "type": "object",
  "properties": {
    "t": {
      "const": "time"
    },
    "local": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "utc_offset_min": {
      "type": "integer",
      "minimum": -720,
      "maximum": 840
    }
  },
  "required": [
    "t",
    "local",
    "utc_offset_min"
  ],
  "additionalProperties": true
}
