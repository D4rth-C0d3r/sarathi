---
# C++ style for firmware/. Google base, 100 columns (see CLAUDE.md).
Language: Cpp
BasedOnStyle: Google
Standard: c++17
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  # C++ standard library: <vector>, <cstdint>, ... (prefer these over <stdint.h>)
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  # Project headers: "sarathi_*/..." or "board_pins.h"
  - Regex: '^"'
    Priority: 3
  # Third-party and C headers: <Arduino.h>, <lvgl.h>, <esp_log.h>, ...
  - Regex: '.*'
    Priority: 2
